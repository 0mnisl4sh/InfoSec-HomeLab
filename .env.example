# Скопируй в .env:  cp .env.example .env
# Пароли учебные. Стенд слушает только 127.0.0.1 — наружу не выставляй.

TZ=Europe/Moscow

# ---------- app-01 ----------
LAB_FQDN=app-01.lab
LAB_ADMIN_USER=labadmin
LAB_ADMIN_PASSWORD=labadmin
# Вставь сюда свой публичный ключ, чтобы сразу заходить без пароля:
#   cat ~/.ssh/id_ed25519.pub
LAB_ADMIN_PUBKEY=

# ---------- Удостоверяющий центр ----------
CA_PASSPHRASE=labpass
CA_ORG=InfoSec HomeLab
CA_COUNTRY=RU

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=rootpass

# ---------- Redis ----------
REDIS_PASSWORD=redispass

# ---------- RabbitMQ ----------
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=rabbitpass

# ---------- Zabbix (compose.zabbix.yml) ----------
ZBX_DB_ROOT_PASSWORD=zbxroot
ZBX_DB_PASSWORD=zbxpass

# ---------- GitLab (compose.gitlab.yml, опционально) ----------
GITLAB_ROOT_PASSWORD=ChangeMe_GitLab123
